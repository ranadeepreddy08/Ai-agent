# ── Adaptive Agent Runtime — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM Provider (Phase 1: Gemini) ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash          # or gemini-2.0-flash-exp

# ── Web Search (optional — leave blank to use mock backend) ─────────────────
# TAVILY_API_KEY=your_tavily_api_key_here
# SERPER_API_KEY=your_serper_api_key_here    # future backend

# ── Agent Behaviour ─────────────────────────────────────────────────────────
MAX_ITERATIONS=20
MAX_TOOL_CALLS=30
MAX_LLM_CALLS=50
MAX_RETRIES=3
MAX_EXECUTION_TIME=300
